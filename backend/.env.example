# ─── Django ──────────────────────────────────────────────────────────────────
DJANGO_SECRET_KEY=kodisha-local-super-secret-key-tanzania-2025
DJANGO_DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1,10.0.2.2,*

# ─── Kodisha AI ──────────────────────────────────────────────────────────────
# Chagua provider: "gemini" (bure) au "ollama".
AI_PROVIDER=gemini

# Google Gemini (FREE): https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
AI_TIMEOUT=90

# Ollama (hiari, kama utatumia Ollama Cloud au local Ollama)
OLLAMA_BASE_URL=https://ollama.com
OLLAMA_API_KEY=
OLLAMA_MODEL=gpt-oss:120b
OLLAMA_TIMEOUT=90
