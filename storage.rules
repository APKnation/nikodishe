rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {

    function isAuthenticated() {
      return request.auth != null;
    }

    function isImage() {
      return request.resource.contentType.matches('image/.*');
    }

    function isSmallFile() {
      return request.resource.size < 5 * 1024 * 1024; // 5MB limit
    }

    // Public item pictures - Anyone can view, only authenticated owners can upload
    match /listings/{listingId}/{fileName} {
      allow read: if true;
      allow write: if isAuthenticated() && isImage() && isSmallFile();
    }

    // User profile avatars - Only owner can update their avatar
    match /users/{userId}/{fileName} {
      allow read: if true;
      allow write: if isAuthenticated() && request.auth.uid == userId && isImage() && isSmallFile();
    }
  }
}

